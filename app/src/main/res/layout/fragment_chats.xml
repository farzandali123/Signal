<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1c1c1c"
    tools:context=".ChatsFragment">

    <!-- Main Layout for content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Search Bar Overlay -->
        <LinearLayout
            android:id="@+id/searchOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="#333333"
            android:visibility="gone">

            <ImageView
                android:id="@+id/searchBackIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/back_icon"
                app:tint="@android:color/white"
                android:contentDescription="Back to chats"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/darker_gray"
                android:background="@null"
                android:padding="8dp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Top Bar with Profile Icon, Signal Title, and Search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Profile Icon -->
            <ImageView
                android:id="@+id/profileIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/profile"
                android:contentDescription="Profile Icon"
                android:layout_marginEnd="16dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:tint="@android:color/white" />

            <!-- Signal Title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Signal"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Search Icon -->
            <ImageView
                android:id="@+id/searchicon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/searchicon"
                app:tint="@android:color/white"
                android:contentDescription="Search"
                android:layout_marginEnd="16dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <!-- Settings Icon -->
            <ImageView
                android:id="@+id/settingsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/dots"
                app:tint="@android:color/white"
                android:contentDescription="Settings"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Placeholder for Empty State -->
        <LinearLayout
            android:id="@+id/emptyStateContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="16dp">

            <ImageView
                android:id="@+id/emptyStateIcon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/profile"
                android:tint="@android:color/darker_gray"
                android:contentDescription="No chats available"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/emptyStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No chats available"
                android:textColor="@android:color/darker_gray"
                android:textSize="16sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- ScrollView for Chats -->
        <ScrollView
            android:id="@+id/chatsScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/chatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

    </LinearLayout>

    <!-- Floating Action Button for Starting New Chat -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_new_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/plus_round_icon"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:tint="@android:color/white"
        app:backgroundTint="@color/purple_200"
        android:contentDescription="Start New Chat" />

    <!-- Floating Action Button for Camera -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cameraicon"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        app:tint="@android:color/white"
        app:backgroundTint="@color/purple_200"
        android:contentDescription="Open Camera" />

</FrameLayout>
